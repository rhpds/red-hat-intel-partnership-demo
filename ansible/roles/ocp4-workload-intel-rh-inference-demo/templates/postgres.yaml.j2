---
apiVersion: v1
kind: PersistentVolumeClaim
metadata:
  name: postgres-data
  namespace: "{{ intel_rh_inference_namespace }}"
spec:
  accessModes: ["ReadWriteOnce"]
  resources:
    requests:
      storage: "{{ intel_rh_inference_postgres_storage }}"
---
apiVersion: apps/v1
kind: Deployment
metadata:
  name: postgres
  namespace: "{{ intel_rh_inference_namespace }}"
  labels:
    app.kubernetes.io/name: postgres
spec:
  replicas: 1
  strategy:
    type: Recreate
  selector:
    matchLabels:
      app.kubernetes.io/name: postgres
  template:
    metadata:
      labels:
        app.kubernetes.io/name: postgres
    spec:
      containers:
        - name: postgres
          image: "{{ intel_rh_inference_postgres_image }}"
          ports:
            - containerPort: 5432
          envFrom:
            - secretRef:
                name: postgres-credentials
          resources:
            requests:
              cpu: "{{ intel_rh_inference_postgres_cpu_request }}"
              memory: "{{ intel_rh_inference_postgres_memory_request }}"
            limits:
              cpu: "{{ intel_rh_inference_postgres_cpu_limit }}"
              memory: "{{ intel_rh_inference_postgres_memory_limit }}"
          securityContext:
            runAsNonRoot: true
            allowPrivilegeEscalation: false
            capabilities:
              drop: ["ALL"]
          volumeMounts:
            - name: data
              mountPath: /var/lib/pgsql/data
          livenessProbe:
            exec:
              command: ["pg_isready", "-U", "{{ intel_rh_inference_postgres_user }}"]
            initialDelaySeconds: 15
            periodSeconds: 20
          readinessProbe:
            exec:
              command: ["pg_isready", "-U", "{{ intel_rh_inference_postgres_user }}"]
            initialDelaySeconds: 5
            periodSeconds: 10
      volumes:
        - name: data
          persistentVolumeClaim:
            claimName: postgres-data
---
apiVersion: v1
kind: Service
metadata:
  name: postgres
  namespace: "{{ intel_rh_inference_namespace }}"
spec:
  selector:
    app.kubernetes.io/name: postgres
  ports:
    - port: 5432
      targetPort: 5432
  type: ClusterIP

---
apiVersion: v1
kind: Secret
metadata:
  name: postgres-credentials
  namespace: "{{ intel_rh_inference_namespace }}"
type: Opaque
stringData:
  POSTGRES_USER: "{{ intel_rh_inference_postgres_user }}"
  POSTGRES_PASSWORD: "{{ intel_rh_inference_postgres_password }}"
  DATABASE_URL: "postgresql://{{ intel_rh_inference_postgres_user }}:{{ intel_rh_inference_postgres_password }}@postgres.{{ intel_rh_inference_namespace }}.svc:5432/gateway"
---
apiVersion: v1
kind: Secret
metadata:
  name: gateway-config
  namespace: "{{ intel_rh_inference_namespace }}"
type: Opaque
stringData:
  LITELLM_API_KEY: "{{ intel_rh_inference_litellm_api_key }}"
  LITELLM_API_BASE: "{{ intel_rh_inference_litellm_api_base }}"

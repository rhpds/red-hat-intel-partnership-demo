# Intel-Red Hat AI Inference Platform — Environment Configuration
#
# Copy this to .env and fill in your values:
#   cp .env.example .env

# LiteLLM proxy API (not the frontend UI)
LITELLM_API_BASE=https://maas-rhdp.apps.maas.redhatworkshops.io
LITELLM_API_KEY=

# Gateway API key (protects the gateway's /v1/route endpoint)
API_KEY=

# HuggingFace token (for model downloads)
HF_TOKEN=

# PostgreSQL password (required for podman-compose)
POSTGRES_PASSWORD=

# Local fallback (loads TinyLlama in the gateway container)
LOCAL_FALLBACK_ENABLED=true
